{
  "name": "decky-hdr",
  "version": "0.4.19",
  "description": "Decky Loader plugin for automatic HDR switching and HDR compatibility badges in Steam Game Mode",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "node --test tests/auto-hdr-toggle.test.mjs && python3 -B -m unittest discover -s tests -p 'test_auto_hdr_toggle.py'"
  },
  "keywords": [
    "decky",
    "decky-loader",
    "hdr",
    "gamescope",
    "steam",
    "steam-game-mode",
    "pcgamingwiki",
    "bazzite",
    "steamos"
  ],
  "author": "Nils",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
